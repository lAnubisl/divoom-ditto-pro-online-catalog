[Unit]
Description=Divoom web gallery with background animation schedule
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
User=divoom-gallery-web
Group=divoom-gallery-web
WorkingDirectory=/opt/divoom-gallery-web
Environment=DIVOOM_WEB_PORT=8090
Environment=DIVOOM_WEB_HOST=0.0.0.0
Environment=DATA_DIR=/var/lib/divoom-gallery-web
EnvironmentFile=/etc/divoom-gallery-web/divoom-gallery-web.env
ExecStart=/opt/divoom-gallery-web/divoom-gallery-web
Restart=on-failure
RestartSec=30s
TimeoutStopSec=240s
StateDirectory=divoom-gallery-web
StateDirectoryMode=0750
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
