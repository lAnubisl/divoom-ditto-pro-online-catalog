DIVOOM_API_BASE_URL=http://raspberrypi.local:8080
DIVOOM_API_KEY=YOUR-API-KEY
DIVOOM_GALLERY_EMAIL=your@email.example
DIVOOM_GALLERY_PASSWORD=your-password
# Required: password for the web login page.
DIVOOM_WEB_PASSWORD=replace-with-a-private-web-password
# Optional: web server port (1-65535, default 8090).
DIVOOM_WEB_PORT=8090
# Optional: bind address (default 127.0.0.1; use 0.0.0.0 for LAN access).
# DIVOOM_WEB_HOST=0.0.0.0
# Optional: shared data root (default var/lib/divoom_gallery_web/, relative to the working directory).
# The supplied systemd unit sets DATA_DIR=/var/lib/divoom-gallery-web.
# DATA_DIR=/var/lib/divoom-gallery-web
